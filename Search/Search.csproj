<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Search for Windows. WinUI 3 for everything drawn, WebView2 for pages — the
    Windows counterparts of SwiftUI and WKWebView in the Mac app next door.
    Unpackaged and self-contained: one folder, double-click Search.exe, no
    installer and no runtime to fetch first.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Search</RootNamespace>
    <AssemblyName>Search</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Search.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PlatformTarget Condition="'$(Platform)' == ''">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <Company>Office Commun</Company>
    <Product>Search</Product>
    <!-- Startup time is the product: ReadyToRun compiles ahead so the first
         window doesn't wait on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Main is ours (see Program in App.xaml.cs): a second launch hands its
         links to the first and leaves before any window is made. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pieces of the Windows App SDK a browser uses, not the whole
         metapackage: that one carries an ONNX runtime, DirectML and the rest
         of the AI stack, a hundred megabytes nobody here asked for. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Search.Kit\Search.Kit.csproj" />
  </ItemGroup>

  <!-- An unpackaged publish leaves out the app's resource index (Search.pri)
       and its compiled XAML, which a build puts beside the exe. Without the
       index WinUI can't find its own themes: dialogs come up square, fields
       white, and a menu using WinUI's own item styles brings the app down. -->
  <Target Name="PublishResourceIndex" AfterTargets="Publish">
    <ItemGroup>
      <_ResourceIndex Include="$(OutDir)$(TargetName).pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_ResourceIndex)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
