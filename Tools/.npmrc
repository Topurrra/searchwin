# pnpm + npm config for KeepItLocal.
#
# strict-dep-builds=false
#   pnpm 11+ promotes "ignored build scripts" from a warning to a hard
#   error in non-interactive contexts (CI, beforeBuildCommand, etc.).
#   The only dep that triggers this is es5-ext (a transitive of
#   svelte-i18n) whose postinstall just prints a sponsorship message —
#   nothing we need. Setting strict-dep-builds=false demotes it back
#   to a warning so `pnpm tauri build` doesn't abort the whole build.
#
#   The pnpm.ignoredBuiltDependencies field in package.json is the
#   "official" way to silence this per-package, but it requires a
#   lockfile refresh that's awkward in a frozen-deps workflow. The
#   .npmrc flag is global and persistent.
strict-dep-builds=false
