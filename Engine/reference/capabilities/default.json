{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. Only the permissions actually exercised by frontend code are listed here — anything more grants the webview surface area we don't need and that an attacker could misuse if a sandbox-escape ever surfaced.",
  "windows": ["main", "welcome", "command", "mouse-grid", "ui-elements", "focus-break", "focus-glow", "notify-toast", "splashscreen", "quicknote", "quicknote-*", "screenrec-region", "screenrec-redact", "screenrec-toolbar"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-is-visible",
    "core:window:allow-is-focused",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-inner-position",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-write-text-file",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "notification:default"
  ]
}
